@model IEnumerable<Category>

@{
    ViewData["Title"] = "Category Management";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["ToastrMessage"] != null)
{
    <script>
        toastr.success('@TempData["ToastrMessage"]');
    </script>
}

<div class="mb-3">
    <a href="@Url.Action("Create", "Category")" class="btn btn-primary">Create</a>
</div>

<table id="categoriesTable" class="table table-bordered table-striped">
    <thead>
        <tr>
            <th class="col-10">Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>
                    <a href="@Url.Action("Edit", "Category", new { id = category.Id })" class="btn btn-warning">Edit</a>
                    <a href="@Url.Action("Delete", "Category", new { id = category.Id })" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#categoriesTable').DataTable();
        });
    </script>
}
